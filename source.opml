				<outline text="function trimJsonl (jsonltext, maxLines) {">
					<outline text="var lines = jsonltext.split (&quot;\n&quot;), ctlines = lines.length;"/>
					<outline text="if (ctlines &gt; 0) {" created="Wed, 13 May 2026 14:50:03 GMT">
						<outline text="if (lines [ctlines - 1] === &quot;&quot;) { //there's a blank line at the end, remove it">
							<outline text="lines.pop ();"/>
							<outline text="ctlines = lines.length; //it changed" created="Wed, 13 May 2026 14:56:51 GMT"/>
							<outline text="}" created="Wed, 13 May 2026 14:52:30 GMT"/>
							</outline>
						<outline text="}" created="Wed, 13 May 2026 14:50:12 GMT"/>
						</outline>
					<outline text="if (ctlines &gt; maxLines) {">
						<outline text="lines = lines.slice (ctlines - maxLines);"/>
						<outline text="}"/>
						</outline>
					<outline text="return lines.join (&quot;\n&quot;) + &quot;\n&quot;;"/>
					<outline text="}"/>
					</outline>
