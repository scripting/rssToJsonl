			<outline text="worknotes.md" created="Tue, 29 Jul 2025 19:36:11 GMT">
				<outline text="#### 5/13/26; 9:17:35 AM by DW" created="Wed, 13 May 2026 13:17:34 GMT">
					<outline text="Gets its own project file --- rssToJsonl." created="Wed, 13 May 2026 13:17:36 GMT"/>
					<outline text="Changed from random feeds to my feeds, starting with Scripting News. " created="Wed, 13 May 2026 13:18:00 GMT"/>
					<outline text="Added an enabled boolean to a set. If you turn it off we won't look at that set. " created="Wed, 13 May 2026 14:35:26 GMT"/>
					<outline text="Added a max number of items in the JSONL file, config.maxLinesPerJsonlFile." created="Wed, 13 May 2026 13:18:17 GMT"/>
					</outline>
				<outline text="#### 5/11/26; 7:50:45 PM by DW" created="Mon, 11 May 2026 23:50:44 GMT">
					<outline text="Started over. I just want to generate a JSONL feed from a set of RSS feeds." created="Mon, 11 May 2026 23:50:45 GMT"/>
					<outline text="We assume all the feeds are subscribed to in the FeedLand we're talking to." created="Mon, 11 May 2026 23:51:04 GMT"/>
					<outline text="We listen through the FeedlandSocket interface, and flow out all news from the feeds via JSONL." created="Mon, 11 May 2026 23:51:16 GMT"/>
					</outline>
				</outline>
